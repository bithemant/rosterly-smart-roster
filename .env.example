# Local PostgreSQL from compose.yaml
DATABASE_URL="postgresql://rosterly:rosterly_local@localhost:5432/rosterly?schema=public"

# Required for one-time initial administrator setup; use a long random value.
SETUP_TOKEN="replace-before-first-admin-setup"

# Provider-switchable, OpenAI-compatible AI endpoint. The key stays server-side.
AI_PROVIDER="openai-compatible"
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4.1-mini"
AI_API_KEY=""
AI_PROVIDER_LABEL="OpenAI-compatible provider"
